 "mannequin3d": {
  "tool": "tools/mannequin3d/request.py",
  "carry": "tools/mannequin3d/specs/carry3d.json",
  "carry_key": "magda",
  "carry_sha256": "b679e2ff03660f85e7a284ee960a37bbfb1a874c3d6c91c3e466c4673d7acba6",
  "sheet_scale_from": "art/requests/phase3.json",
