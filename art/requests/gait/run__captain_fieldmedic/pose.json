  },
  "personality": {
   "lean_add": [
    -4.0,
    -3.0,
    -3.0,
    -3.0
   ],
   "hip_drop": -2.0,
   "neck_up": 5.0,
   "pelvis_twist": 5.0,
   "swing_add": {
    "0.5": [
