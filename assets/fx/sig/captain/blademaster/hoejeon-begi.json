  "axes": { "footprint": "per-victim-mark", "motion": "lateral", "beat": "1 accent, late echo +0.11", "cadence": "fast spin, dead still 370ms, snap", "screen": ["dim", "punch", "hitstop", "shake.x"], "density": "one" },
