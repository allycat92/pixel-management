{
  "id": "sig/captain/blademaster/hoejeon-begi",
  "tier": "ultimate-pilot",
  "status": "draft",
  "bind": { "owner": "captain/blademaster", "skill": "회전베기" },
  "kit": "captain/blademaster",
  "keyImage": { "kind": "novelai-design-draft", "ref": "nai_baren_r2_2 (owner pick 2026-11-28)", "note": "reference only - never shipped, never registered, not in the repo" },
  "pieceSheets": "fx/sig/captain/blademaster/<piece> when registered; until then FxPlaceholders (code-drawn PLACEHOLDER) draws the same size/frames/origin",
  "duration": 2.3,
  "timeline": { "preset": "tl.phases", "phases": [
    ["dim-in", 0.0, 0.18], ["spin", 0.18, 0.45], ["still", 0.45, 0.60], ["cut", 0.60, 0.617],
    ["hitstop", 0.617, 0.70], ["split", 0.70, 0.95], ["residue", 0.95, 1.70], ["release", 1.70, 2.30]
  ] },
  "actor": {
    "poses": { "idle": ["idle", null], "ready": ["attack", 0], "follow": ["attack", 1] },
    "track": [ { "at": 0, "pose": "idle" }, { "at": 0.08, "pose": "ready" }, { "at": 0.18, "pose": "follow" }, { "at": 1.75, "pose": "idle" } ],
    "spin": { "preset": "actor.spin", "at": 0.18, "dur": 0.27, "step": 0.045 }
  },
  "marks": {
    "per": "victim", "anchor": "victim.body", "facing": "attacker",
    "heights": { "preset": "place.spreadHeights", "lo": 0.26, "hi": 0.80, "jit": 0.4 }
  },
  "layers": [
    { "id": "gleam", "phase": "still", "per": "cast", "piece": "gleam", "at": 0.47, "anchor": "self.tip",
      "clock": { "preset": "clock.hold", "frames": [0, 1, 0], "ms": [50, 40, 40], "mode": "once" },
      "slot": "front", "blend": "lighter", "core": true },
    { "id": "tipglow", "phase": "still", "per": "cast", "light": { "preset": "curve.attackDecay", "rise": 0.04, "decay": 0.07 },
      "at": 0.47, "anchor": "self.tip", "radius": 9, "alpha": 0.32, "colour": "key", "slot": "front", "blend": "lighter" },
    { "id": "cut", "phase": "cut", "per": "victim", "piece": "cutline", "at": 0.60, "anchor": "mark",
      "stagger": { "preset": "place.stagger", "dt": 0, "jit": 0, "order": "nearest" },
      "clock": { "preset": "clock.hold", "frames": [0, 1, 2], "ms": [170, 70, 70], "mode": "once" },
      "slot": "sorted", "zBias": 2, "blend": "source-over", "core": true },
    { "id": "cutglow", "phase": "cut", "per": "victim", "light": { "preset": "curve.attackDecay", "rise": 0.0, "decay": 0.08 },
      "at": 0.60, "anchor": "mark", "radius": 13, "alpha": 0.2, "colour": "key", "slot": "front", "blend": "lighter" },
    { "id": "split", "phase": "split", "per": "victim", "piece": "split", "at": 0.71, "anchor": "mark",
      "stagger": { "preset": "place.stagger", "dt": 0.022, "jit": 0.006, "order": "nearest" },
      "clock": { "preset": "clock.hold", "frames": [0, 1, 2, 3], "ms": [55, 70, 70, 90], "mode": "once" },
      "slot": "over", "blend": "source-over", "core": true },
    { "id": "cloth", "phase": "split", "per": "victim", "after": "split", "delay": 0.0, "anchor": "mark", "dir": "away",
      "emitter": { "preset": "emit.fan", "n": 2, "spread": 1.4, "sp": [40, 75], "life": [0.7, 1.1], "up": 30, "sway": 3, "swayHz": 1.6, "grav": 70, "drag": 2.5 },
      "piece": "band_tail", "pieceClock": { "preset": "clock.hold", "frames": [0, 1, 2, 1], "ms": [90, 90, 90, 90], "mode": "loop" },
      "slot": "front", "blend": "source-over" },
    { "id": "clothSpin", "phase": "spin", "per": "cast", "at": 0.26, "anchor": "self.chest", "dir": "up",
      "emitter": { "preset": "emit.fan", "n": 3, "spread": 2.6, "sp": [35, 60], "life": [1.0, 1.4], "up": 10, "sway": 4, "swayHz": 1.3, "grav": 45, "drag": 2.0 },
      "piece": "band_tail", "pieceClock": { "preset": "clock.hold", "frames": [0, 1, 2, 1], "ms": [110, 110, 110, 110], "mode": "loop" },
      "slot": "front", "blend": "source-over" }
  ],
  "victimReact": { "after": "split", "anim": "hit", "dur": 0.26, "push": 2 },
  "screen": {
    "dim": { "preset": "curve.envelope", "at": 0.0, "in": 0.22, "hold": 1.38, "out": 0.4, "alpha": 0.66, "colour": "tone", "only1x": true },
    "unitDim": { "who": "others", "preset": "curve.envelope", "at": 0.0, "in": 0.22, "hold": 1.38, "out": 0.4, "alpha": 0.42, "colour": "tone", "only1x": true },
    "freeze": [
      { "preset": "screen.freeze", "at": 0.45, "dur": 0.15, "why": "still hold before the cut (kit cadence 120-160ms)" },
      { "preset": "screen.freeze", "at": 0.60, "dur": 0.10, "why": "hitstop on the cut" }
    ],
    "shake": [ { "preset": "screen.shake", "at": 0.71, "amp": 2, "decay": 0.08, "axis": "x" } ],
    "letterbox": { "preset": "screen.letterbox", "at": 0.0, "h": 26, "in": 0.2, "hold": 1.5, "out": 0.3, "colour": "ink", "edge": { "colour": "key", "at": 0.60, "dur": 0.05 }, "only1x": true }
  },
  "axes": { "footprint": "per-victim-mark", "motion": "lateral", "beat": "1 accent, late echo +0.11", "cadence": "slow-then-snap", "screen": ["dim", "hitstop", "shake.x"], "density": "one" },
  "budget": { "priority": "signature", "phone": { "drop": ["cloth", "clothSpin", "cutglow"], "residueK": 0.5 } }
}
